--- !u!114 &114794749260095204
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1039697568401756}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.8627451, g: 0.8627451, b: 0.8627451, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 13
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: '<b>States conditions</b>: [H / B]

    <i>returns true if the site is
    highlighted / blacklisted</i>


    <b>Location conditions</b>: [ROI / MESH /
    CUT]

    <i>returns true if the site is in the selected region of interest /
    inside the brain mesh / on any cut plane</i>


    <b>Position conditions</b>:
    [X / Y / Z] [> / <] xxx

    <i>return true is the site position match the condition</i>


    <b>Atlas
    area condition</b>: [ATLAS_AREA] = "AREA_NAME"

    <i>returns true if the site
    is in an area of the selected atlas containing AREA_NAME in its name or ID</i>


    <b>Information
    conditions</b>: [NAME / PAT_NAME / PAT_PLACE / PAT_DATE / LABEL] = "xxxx"

    <i>returns
    true if the name of the site / the name of the patient / the place of the patient
    / the date of the patient / one of the labels contains "xxxx"</i>


    <b>Tag
    condition</b>: [TAG] = "TAG_NAME:TAG_VALUE"

    <i>returns true if the site
    contains a tag that has the name TAG_NAME and which value contains TAG_VALUE</i>


    <b>Values
    conditions</b>: [MEAN / MEDIAN / MAX / MIN / STDEV] [> / <] xxx

    <i>returns
    true if the mean / median / maximum / minimum / standard deviation of the EEG
    values of the site is greater / lesser than xxx</i>


    <b>Operators</b>: &
    (and), | (or), ! (not), parentheses (priority)


    <b>Examples of advanced
    conditions</b>:

    - (H & !B) | MEAN > 100

    - MEDIAN < 90 | MEDIAN > 110

    -
    NAME = "A" & PAT = "BATg"

    - TAG = "MarsAtlas:Insular Cortex"'

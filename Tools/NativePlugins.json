{
  "schemaVersion": 1,
  "branch": "master",
  "workflow": "native.yml",
  "libraries": [
    {
      "name": "EEGFormat",
      "repository": "hbp-HiBoP/EEGFormat",
      "manifestRepository": "EEGFormat",
      "targets": [
        {
          "platform": "Windows",
          "architecture": "x86_64",
          "payload": "EEGFormat.dll",
          "destination": "Assets/Plugins/Native/Windows/x86_64/EEGFormat.dll"
        },
        {
          "platform": "Linux",
          "architecture": "x86_64",
          "payload": "libEEGFormat.so",
          "destination": "Assets/Plugins/Native/Linux/x86_64/libEEGFormat.so"
        },
        {
          "platform": "MacOS",
          "architecture": "arm64",
          "payload": "EEGFormat.bundle",
          "destination": "Assets/Plugins/Native/macOS/arm64/EEGFormat.bundle"
        }
      ]
    },
    {
      "name": "hbp_core",
